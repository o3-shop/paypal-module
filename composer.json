{
    "name": "o3-shop/paypal-checkout",
    "description": "O3-Shop PayPal Checkout module (fork of oxid-solution-catalysts/paypal-module)",
    "type": "oxideshop-module",
    "keywords": ["oxid", "modules", "eShop", "paypal", "payment"],
    "homepage": "https://www.o3-shop.com/",
    "license": ["GPL-3.0"],
    "authors": [
        {
            "name": "O3-Shop",
            "email": "info@o3-shop.com",
            "homepage": "https://www.o3-shop.com",
            "role": "Developer"
        },
        {
            "name": "OXID eSales AG",
            "email": "info@oxid-esales.com",
            "homepage": "https://oxid-esales.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/o3-shop/paypal-module",
        "issues": "https://github.com/o3-shop/paypal-module/issues"
    },
    "replace": {
        "oxid-solution-catalysts/paypal-module": "self.version"
    },
    "extra": {
        "oxideshop": {
            "target-directory": "osc/paypal",
            "blacklist-filter": [
                "resources/**/*",
                "tests/**/*"
            ]
        }
    },
    "require": {
        "giggsey/libphonenumber-for-php": "^8.12",
        "viison/address-splitter": "^0.3.4",
        "webmozart/path-util": "^2.3.0",
        "o3-shop/paypal-client": "^3.0.20",
        "php": "^7.4|^8.0|^8.1",
        "symfony/event-dispatcher": "*"
    },
    "require-dev": {
        "symfony/dotenv": "*",
        "squizlabs/php_codesniffer": "3.*",
        "phpmd/phpmd": "^2.11",
        "oxid-esales/oxideshop-ce": "^6.8",
        "phpstan/phpstan": "^1.10"
    },
    "conflict": {
        "oxid-esales/oxideshop-ce": "<6.8 | ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OxidSolutionCatalysts\\PayPal\\": "src/",
            "OxidSolutionCatalysts\\PayPal\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpmd": "./.github/scripts/codestyle_check.sh phpmd",
        "phpmd:commit": "./.github/scripts/codestyle_check.sh phpmd commit",
        "phpstan": "./.github/scripts/codestyle_check.sh phpstan",
        "phpstan:commit": "./.github/scripts/codestyle_check.sh phpstan commit",
        "phpcs": "./.github/scripts/codestyle_check.sh phpcs",
        "phpcs:commit": "./.github/scripts/codestyle_check.sh phpcs commit",
        "style": "./.github/scripts/codestyle_check.sh all",
        "style:commit": "./.github/scripts/codestyle_check.sh all commit",
        "phpcbf": "phpcbf --standard=tests/phpcs.xml",

        "static": [
            "@phpcs",
            "@phpstan",
            "@phpmd"
        ],
        "generate-reports": [
            "@phpstan-report",
            "@phpmd-report"
        ],
        "generate-baselines": [
            "@phpstan-generate-baseline",
            "@phpmd-generate-baseline"
        ]
    },
    "config": {
        "allow-plugins": {
            "oxid-esales/oxideshop-unified-namespace-generator": true,
            "oxid-esales/oxideshop-composer-plugin": true
        }
    }
}
